      "beyannameExe": "BEYANNAME.EXE",
      "setupPatterns": {
        "client": "{prefix}_{versionTag}_Client_Setupx064.exe",
        "eDefter": "{prefix}_{versionTag}_eDefter_Setupx064.exe",
        "beyanname": "{versionTag}_BEYANNAME_Setupx064.exe"
      },
      "products": [
        {
          "name": "Jump",
          "prefix": "Jump",
          "clientExe": "MikroJump.EXE",
          "eDefterExe": "myEDefterStandart.exe"
        },
        {
          "name": "Fly",
          "prefix": "Fly",
          "clientExe": "MikroFly.EXE",
          "eDefterExe": "MyeDefter.exe"
        }
      ]
